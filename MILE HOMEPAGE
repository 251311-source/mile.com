function openModal(type){
 let c='';
 if(type==='login')c=`<h2>로그인</h2><p style="color:#777">학교 프로젝트용 데모 로그인입니다.</p><input placeholder="이메일"><input type="password" placeholder="비밀번호"><div class="modal-actions"><button class="primary" onclick="closeModal();go('mymile')">로그인</button><button class="close" onclick="closeModal()">닫기</button></div>`;
 if(type==='search')c=`<h2>검색</h2><input id="globalSearch" placeholder="MILE에서 무엇을 찾을까요?"><button class="primary" onclick="let q=document.getElementById('globalSearch').value;closeModal();go(q.includes('정책')||q.includes('지원')?'info':'kit')">검색하기</button>`;
 if(type==='post')c=`<h2>글쓰기</h2><input placeholder="제목"><textarea rows="5" placeholder="내용을 입력하세요."></textarea><button class="primary" onclick="closeModal();toast('게시글 작성 데모가 완료되었습니다.')">게시하기</button>`;
 if(type==='menu')c=`<h2>MILE</h2><p><button class=textbtn onclick="closeModal();go('kit')">첫걸음 키트</button></p><p><button class=textbtn onclick="closeModal();go('info')">info-mile</button></p><p><button class=textbtn onclick="closeModal();go('community')">Community</button></p><p><button class=textbtn onclick="closeModal();go('magazine')">Magazine</button></p><p><button class=textbtn onclick="closeModal();go('mymile')">My MILE</button></p>`;
 openCustom(c);
}

function openCustom(c, isLarge = false){
 const box = document.getElementById('modalBox');
 box.innerHTML = c;
 if(isLarge){
   box.classList.add('large-modal');
   if(box.querySelector('.mileage-box')) box.classList.add('mileage-fullscreen');
 } else {
   box.classList.remove('large-modal','mileage-fullscreen');
 }
 document.getElementById('modal').classList.add('open');
 document.body.classList.add('modal-open');
}

function closeModal(){
 const box = document.getElementById('modalBox');
 box.classList.remove('large-modal','mileage-fullscreen');
 document.getElementById('modal').classList.remove('open');
 document.body.classList.remove('modal-open');
}

function toast(t){let e=document.getElementById('toast');e.textContent=t;e.style.display='block';clearTimeout(window.tt);window.tt=setTimeout(()=>e.style.display='none',2200)}

document.getElementById('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
</script>
