}

function svgEl(tag, attrs={}){
  const el = document.createElementNS('http://www.w3.org/2000/svg',tag);
  Object.entries(attrs).forEach(([k,v]) => el.setAttribute(k,v));
  return el;
}

function drawConstellationLabel(svg, constellation){
  const first = constellation.stars[0];
  const title = svgEl('text',{
    x:first.x,y:55,class:'constellation-title',
    fill:'#c4c9e5','font-size':'15','font-weight':'500'
  });
  title.textContent = constellation.title;
  svg.appendChild(title);

  const sub = svgEl('text',{
    x:first.x,y:77,class:'constellation-label',
    fill:'#6e7696','font-size':'10','letter-spacing':'1.2'
  });
  sub.textContent = constellation.subtitle;
  svg.appendChild(sub);
}

function renderConstellationSVG(animateSegment=-1){
  const svg = document.getElementById('constellation-svg');
  if(!svg) return;
  svg.innerHTML = '';

  // 별자리마다 은은한 궤적을 만들고, 마일리지 진행도에 따라 순서대로 밝힙니다.
  let globalIndex = 0;

  mileageConstellations.forEach((constellation, cIndex) => {
    drawConstellationLabel(svg,constellation);

    // 별자리 내부 연결선
    for(let i=0;i<constellation.stars.length-1;i++){
      const a=constellation.stars[i], b=constellation.stars[i+1];
      const line=svgEl('line',{
        x1:a.x,y1:a.y,x2:b.x,y2:b.y,
        class:'constellation-line'+(userMileage >= (globalIndex+i+1)*pointsPerStar ? ' active':'')
      });
      svg.appendChild(line);

      // 이번 적립으로 새롭게 연결된 구간에 빛을 쏘기
      if(animateSegment === globalIndex+i){
        const beam=svgEl('line',{
          x1:a.x,y1:a.y,x2:b.x,y2:b.y,class:'energy-beam'
        });
        svg.appendChild(beam);

        const core=svgEl('circle',{cx:a.x,cy:a.y,r:4,class:'energy-core'});
        const motion=svgEl('animateMotion',{
          dur:'1.45s',begin:'0s',fill:'freeze',repeatCount:'1',path:`M ${a.x} ${a.y} L ${b.x} ${b.y}`
        });
        core.appendChild(motion);
        svg.appendChild(core);
      }
    }

    // 별자리 사이를 직접 연결하지 않고, 각각의 영역이 우주 지도처럼 독립적으로 뻗어 보이게 함
    const centerX=constellation.stars.reduce((sum,s)=>sum+s.x,0)/constellation.stars.length;
    const centerY=430;
    const arc=svgEl('path',{
      d:`M ${centerX-145} ${centerY} Q ${centerX} ${centerY+35} ${centerX+145} ${centerY}`,
      fill:'none',stroke:'rgba(125,139,207,.12)','stroke-width':'1',
      'stroke-dasharray':'3 8'
    });
    svg.appendChild(arc);

    constellation.stars.forEach((star,i)=>{
      const idx=globalIndex+i;
      const isActive = idx === 0 || userMileage >= (idx)*pointsPerStar;
      const isCurrent = isActive && userMileage < (idx+1)*pointsPerStar;

      const g=svgEl('g');
      const halo=svgEl('circle',{
        cx:star.x,cy:star.y,r:isActive?18:12,
        fill:'none',stroke:isActive?'rgba(244,223,147,.16)':'rgba(100,112,155,.06)',
        'stroke-width':'1'
      });
      const node=svgEl('circle',{
        cx:star.x,cy:star.y,r:isActive?7:5,
        class:'star-node'+(isActive?' active':'')+(isCurrent?' current':'')
      });
      const label=svgEl('text',{
        x:star.x,y:star.y+29,'text-anchor':'middle',
        fill:isActive?'#e9d994':'#59627f',
        'font-size':'11',class:'constellation-label',
        'font-weight':isActive?'600':'400'
      });
      label.textContent=star.name;

      g.appendChild(halo);g.appendChild(node);g.appendChild(label);
      svg.appendChild(g);
    });

    globalIndex += constellation.stars.length;
  });

  // 다음 별을 향하는 작은 방향 표시
  const current=Math.min(Math.floor(userMileage/pointsPerStar),mileageStars.length-1);
  const next=mileageStars[Math.min(current+1,mileageStars.length-1)];
  if(next && current < mileageStars.length-1){
    const marker=svgEl('text',{
      x:next.x,y:next.y-24,'text-anchor':'middle',
      fill:'#8c96bd','font-size':'9','letter-spacing':'1.2'
    });
    marker.textContent='NEXT STAR';
    svg.appendChild(marker);
  }

  // 새로 열린 별자리 위치까지 부드럽게 이동
  // 현재 a 지점의 스크롤 위치를 기준으로 b 지점으로 바로 이동한다.
  if(animateSegment >= 0){
    const targetIndex=Math.min(animateSegment+1,mileageStars.length-1);
    const target=mileageStars[targetIndex];
    const scroll=document.getElementById('starMapScroll');

    const followTarget=()=>{
      if(!scroll || !target) return;

      const currentLeft=scroll.scrollLeft;
      const currentCenter=currentLeft + scroll.clientWidth * 0.5;
      const desiredCenter=target.x;
      const delta=desiredCenter-currentCenter;

      const nextLeft=Math.max(
        0,
        Math.min(
          scroll.scrollWidth-scroll.clientWidth,
          currentLeft+delta
        )
      );

      // 시작점으로 되돌리지 않고 현재 위치에서 b 지점으로 바로 이동
      scroll.scrollTo({left:nextLeft,behavior:'smooth'});
    };

    requestAnimationFrame(followTarget);
    setTimeout(followTarget,520);
  }
}

