function toggleLike(btn){
 const n=btn.querySelector('span');
 const active=btn.classList.toggle('liked');
 let count=parseInt(n.textContent||'0',10);
 n.textContent=active?count+1:Math.max(0,count-1);
 btn.firstChild.textContent=active?'♥ ':'♡ ';
}

function openComments(i){
