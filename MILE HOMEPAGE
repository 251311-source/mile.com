 `);
}

function addComment(i){
 const input=document.getElementById('commentInput');
 const text=(input?.value||'').trim();
 if(!text){toast('댓글 내용을 입력해주세요.');return}
 if(!commentData[i])commentData[i]=[];
 commentData[i].push([text,'MILE_user','방금 전']);
 openComments(i);
 toast('댓글이 등록되었습니다.');
}

