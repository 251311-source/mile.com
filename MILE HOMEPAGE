<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MILE — 자립까지, 삶의 거리를 함께 쌓다</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@400;500;600&family=DM+Serif+Display&display=swap');

:root{
 --lav:#9aa4ee;
 --lav-dark:#7f8bd8;
 --lav-soft:#1a1d3b;
 --cream:#080b19;
 --yellow:#f4df93;
 --yellow-soft:#242137;
 --sky:#9eb8d8;
 --navy:#0d1228;
 --ink:#f3f1eb;
 --muted:#a7aabd;
 --line:rgba(207,213,255,.13);
 --white:#11162b;
 --panel:#10162e;
 --panel-2:#151b37;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;background:#080b19;scrollbar-gutter:stable}
body{
 margin:0;
 background:
   radial-gradient(circle at 78% 4%, rgba(121,132,220,.10), transparent 28%),
   radial-gradient(circle at 10% 30%, rgba(151,132,216,.06), transparent 25%),
   #080b19;
 color:var(--ink);
 font-family:"Noto Sans KR",sans-serif;
}
body:before{
 content:"";
 position:fixed;
 inset:0;
 pointer-events:none;
 z-index:-1;
 opacity:.34;
 background-image:
   radial-gradient(circle at 12% 18%, rgba(255,255,255,.7) 0 1px, transparent 1.5px),
   radial-gradient(circle at 77% 28%, rgba(255,255,255,.55) 0 1px, transparent 1.5px),
   radial-gradient(circle at 42% 72%, rgba(255,255,255,.45) 0 1px, transparent 1.5px);
 background-size:310px 270px, 390px 330px, 270px 310px;
}

button,input,select,textarea{font:inherit}
button{cursor:pointer}

/* NAV — 상단 화면 고정 */

/* ===== MILE 로고: 첫걸음 키트 왼쪽 작은 사이즈 ===== */
.nav-brand-button{
 border:0;background:none;padding:0;margin:0 22px 0 0;width:64px;height:38px;
 display:flex;align-items:center;justify-content:flex-start;flex:0 0 64px;cursor:pointer;
}
.nav-logo-image{
 width:48px;height:34px;object-fit:contain;object-position:left center;display:block;
}

.nav{
 position:fixed;left:0;right:0;top:0;z-index:1000;height:92px;padding:0 5.5vw;
 display:flex;align-items:center;
 background:rgba(8,11,25,.92);backdrop-filter:blur(18px);
 border-bottom:1px solid rgba(203,210,255,.10);
 box-shadow:0 12px 40px rgba(0,0,0,.18);
}
.nav-brand-button{
 border:0;background:none;padding:0;width:150px;height:46px;
 display:flex;align-items:center;justify-content:flex-start;flex:0 0 150px;
}
.logo{width:auto;height:auto;display:block}
.navlinks{display:flex;gap:28px;margin-left:28px}
.navlinks button,.navright button{border:0;background:none;color:#c8cbe0;font-size:14px}
.navlinks button:hover,.navright button:hover{color:#fff}
.navright{margin-left:auto;display:flex;gap:16px;align-items:center}
.cart{position:relative}
.badge{position:absolute;top:-8px;right:-10px;background:var(--lav-dark);color:#fff;font-size:10px;width:17px;height:17px;border-radius:50%;display:grid;place-items:center}
.mobile-menu{display:none;margin-left:auto;border:0;background:none;font-size:23px;color:#fff}

/* PAGES & SECTIONS */
.page{display:none;background:transparent}.page.active{display:block;padding-top:92px}
.section{padding:100px 7vw;background:transparent;color:var(--ink)}
.section.white{background:#0b1022}
.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:42px}
.label{font-size:12px;letter-spacing:2px;color:#aab2ff;font-weight:700}
.section h2{font-size:43px;font-weight:400;letter-spacing:-2.5px;margin:10px 0;color:#f3f1eb}
.section-head p,.section p{color:var(--muted);line-height:1.7}

/* HERO */
.hero-redesign{
 min-height:calc(100vh - 74px);
 display:grid;
 grid-template-columns:47% 53%;
 background:
   radial-gradient(circle at 84% 22%, rgba(143,157,255,.12), transparent 26%),
   linear-gradient(120deg,#080b19 0%,#0a0e20 48%,#111731 100%);
 position:relative;
 overflow:hidden;
}
.hero-copy{padding:7vw 6.5vw 6vw 7vw;position:relative;z-index:4}
.hero-eyebrow{display:flex;align-items:center;gap:12px;color:#b9bed8;font-size:12px;letter-spacing:.08em;margin-bottom:34px}
.hero-eyebrow b{color:#f2efe7;font-weight:600}
.hero-eyebrow i{width:28px;height:1px;background:rgba(255,255,255,.25)}
.eyebrow-dot{width:5px;height:5px;border-radius:50%;background:var(--yellow);box-shadow:0 0 14px rgba(244,223,147,.8)}
.hero-overline{margin:0 0 16px;color:#7f89b8 !important;font-size:10px !important;letter-spacing:.25em;line-height:1.5 !important}
.hero h1{font-family:"Noto Serif KR",serif;font-size:clamp(48px,5.5vw,84px);font-weight:400;line-height:1.16;letter-spacing:-.075em;color:#f4f1ea;margin:0 0 30px}
.hero h1 em{font-family:"DM Serif Display","Noto Serif KR",serif;font-style:normal;color:#aab3ff;letter-spacing:-.035em;text-shadow:0 0 32px rgba(144,155,255,.16)}
.hero-desc{color:#a9adc1 !important;font-size:15px !important;line-height:1.95 !important}
.hero-actions{display:flex;align-items:center;margin-top:32px;gap:22px}
.primary{border:0;background:#a0a9ef;color:#11162d;padding:14px 23px;border-radius:999px;box-shadow:0 10px 30px rgba(121,133,232,.20);font-weight:600}
.primary:hover{background:#c0c7ff;color:#10142a;transform:translateY(-2px)}
.textbtn{border:0;background:none;color:#b5bcf3;padding:12px 2px}
.hero-trail{margin-top:44px;display:flex;align-items:center;gap:13px;color:#6f7699;font-size:11px;letter-spacing:.04em}
.hero-trail i{width:3px;height:3px;border-radius:50%;background:#e4d38c}

.hero-visual{position:relative;overflow:hidden;background:radial-gradient(circle at 50% 32%, rgba(112,126,224,.14), transparent 26%),linear-gradient(135deg,#10162e 0%,#151b38 55%,#1b2143 100%)}
.hero-constellation{isolation:isolate}
.hero-constellation:before{content:"";position:absolute;inset:0;opacity:.58;background-image:radial-gradient(circle at 14% 18%, #fff 0 1px, transparent 1.7px),radial-gradient(circle at 30% 76%, #fff 0 1px, transparent 1.7px),radial-gradient(circle at 72% 12%, #fff 0 1.2px, transparent 1.9px),radial-gradient(circle at 88% 61%, #fff 0 1px, transparent 1.6px);background-size:180px 160px,230px 190px,260px 210px,210px 180px}
.sky-glow{position:absolute;border-radius:50%;filter:blur(28px);pointer-events:none}
.glow-one{width:320px;height:320px;right:6%;top:8%;background:rgba(139,149,235,.12)}
.glow-two{width:240px;height:240px;left:10%;bottom:13%;background:rgba(238,218,145,.06)}
.moon-orb{position:absolute;right:10%;top:12%;width:88px;height:88px;border-radius:50%;background:radial-gradient(circle at 35% 32%,#f6f1dd,#d6d2c6 48%,#aaa9a8 100%);opacity:.18;filter:blur(.2px);box-shadow:0 0 60px rgba(240,232,197,.12)}
.hero-card{position:absolute;z-index:5;right:12%;top:23%;width:min(620px,78%);height:43%;border:1px solid rgba(221,225,255,.16);border-radius:22px;background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));backdrop-filter:blur(16px);box-shadow:0 28px 80px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.06);padding:28px 30px}
.hero-card-top,.hero-card-bottom{display:flex;justify-content:space-between;align-items:center;color:#7d85ab;font-size:9px;letter-spacing:.18em}
.hero-card-star{color:#f4df93;font-size:20px;text-shadow:0 0 18px rgba(244,223,147,.55)}
.hero-card-brand{margin-top:24px;font-family:"DM Serif Display",serif;font-size:clamp(58px,7vw,92px);letter-spacing:-.04em;color:rgba(181,190,255,.16)}
.hero-card-copy{margin-top:-6px;color:#b9bfdc;font-size:11px;letter-spacing:.3em}
.hero-card-route{position:absolute;left:11%;right:11%;bottom:23%;height:42px;border-top:1px solid rgba(255,255,255,.10);transform:rotate(-4deg);border-radius:50%}
.hero-card-route:before{content:"";position:absolute;left:0;right:0;top:14px;height:1px;background:rgba(159,171,244,.32);box-shadow:0 0 15px rgba(159,171,244,.18)}
.hero-card-route span{position:absolute;width:7px;height:7px;border-radius:50%;background:#b5bce9;top:10px;box-shadow:0 0 13px rgba(181,188,233,.55)}
.hero-card-route span:nth-child(1){left:12%}
.hero-card-route span:nth-child(2){left:51%;background:#f4df93;box-shadow:0 0 16px rgba(244,223,147,.55)}
.hero-card-route span:nth-child(3){right:8%}
.hero-card-bottom{position:absolute;left:30px;right:30px;bottom:24px}

.constellation{position:absolute;z-index:2;opacity:.65}
.constellation-a{width:280px;height:230px;right:8%;top:10%}
.constellation-b{width:210px;height:180px;left:5%;bottom:17%;opacity:.36}
.constellation .node{position:absolute;width:7px;height:7px;border-radius:50%;background:#cfd5f5;box-shadow:0 0 12px rgba(207,213,245,.55)}
.constellation .line{position:absolute;height:1px;background:rgba(190,199,244,.28);transform-origin:left center}
.constellation-a .n1{left:5%;top:28%}.constellation-a .n2{left:43%;top:4%}.constellation-a .n3{left:76%;top:32%}.constellation-a .n4{left:63%;top:78%}
.constellation-a .l1{left:6%;top:29%;width:112px;transform:rotate(-28deg)}.constellation-a .l2{left:45%;top:6%;width:100px;transform:rotate(26deg)}.constellation-a .l3{left:76%;top:34%;width:108px;transform:rotate(120deg)}
.constellation-b .n1{left:8%;top:20%}.constellation-b .n2{left:48%;top:52%}.constellation-b .n3{right:4%;top:10%}
.constellation-b .l1{left:9%;top:22%;width:105px;transform:rotate(26deg)}.constellation-b .l2{left:50%;top:52%;width:86px;transform:rotate(-28deg)}

.road{position:absolute;z-index:3;width:125%;height:32%;left:-10%;bottom:-9%;border-top:26px solid rgba(156,166,231,.15);border-radius:50%;transform:rotate(-8deg);box-shadow:0 -10px 45px rgba(141,151,226,.08)}
.road-front{bottom:-13%;border-top-width:5px;border-color:rgba(176,185,249,.40);box-shadow:0 0 18px rgba(150,160,240,.18)}
.road-star{position:absolute;z-index:6;right:13%;bottom:31%;color:#f4df93;font-size:28px;text-shadow:0 0 22px rgba(244,223,147,.75)}
.floating-label{position:absolute;z-index:6;color:#aab1d3;font-size:9px;letter-spacing:.18em;padding:8px 11px;border:1px solid rgba(255,255,255,.08);border-radius:999px;background:rgba(8,11,25,.36);backdrop-filter:blur(8px)}
.label-one{left:10%;bottom:24%}.label-two{right:20%;bottom:18%}

/* SERVICE GRID */
.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.service{position:relative;min-height:280px;border:1px solid rgba(202,208,255,.11);border-radius:24px;padding:31px;overflow:hidden;transition:.25s;background:linear-gradient(145deg,#10162c,#0e1328);box-shadow:0 16px 50px rgba(0,0,0,.12)}
.service:nth-child(2){background:linear-gradient(145deg,#121831,#10152b)}
.service:nth-child(3){background:linear-gradient(145deg,#17172e,#11152b)}
.service:hover{transform:translateY(-5px);box-shadow:0 24px 60px rgba(0,0,0,.25)}
.num{font-size:12px;color:#9297d1;letter-spacing:1.5px}
.service h3{font-size:25px;font-weight:500;margin:35px 0 11px;color:#f1efe8}
.service p{color:#9da2b9;line-height:1.7;font-size:14px}
.service .go{position:absolute;bottom:27px;left:31px;border:0;background:none;color:#aeb6f6;padding:0}
.service .mini-path{position:absolute;right:-25px;bottom:-35px;width:150px;height:100px;border-top:13px solid rgba(157,169,239,.18);border-radius:50%;transform:rotate(-18deg)}

/* JOURNEY & MAGAZINE */
.journey-wrap{background:linear-gradient(145deg,#0d1228,#141a36);color:#fff;border-radius:30px;padding:45px 40px 50px;overflow:hidden;border:1px solid rgba(204,211,255,.08)}
.journey-top{display:flex;justify-content:space-between;align-items:start}
.journey-top p{color:#cfd1df}
.journey{display:grid;grid-template-columns:repeat(4,1fr);position:relative;margin-top:40px}
.journey:before{content:"";position:absolute;top:18px;left:7%;right:7%;height:1px;background:#ffffff40}
.jstep{position:relative;text-align:center}
.jstar{width:12px;height:12px;margin:13px auto 25px;background:var(--yellow);clip-path:polygon(50% 0,61% 37%,100% 50%,61% 63%,50% 100%,39% 63%,0 50%,39% 37%);box-shadow:0 0 17px #f3df9388}
.jstep h4{font-size:15px;margin:0 0 7px;font-weight:500}
.jstep p{margin:0;color:#b9bbca;font-size:12px}

.tools{display:flex;gap:9px;flex-wrap:wrap;margin:28px 0 34px}
.search{flex:1;min-width:250px;padding:14px 17px;border:1px solid rgba(206,212,255,.12);background:#10162c;color:#ecebf0;border-radius:12px;outline:none}
.search::placeholder{color:#6e748e}
select{padding:13px 15px;border:1px solid rgba(206,212,255,.12);background:#10162c;color:#ecebf0;border-radius:12px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}

.policy,.post,.mag,.detail,.builder-step,.pref-card{background:linear-gradient(145deg,#10162d,#0d1328);color:#f1eff0;border:1px solid rgba(207,214,255,.11);border-radius:22px;box-shadow:0 12px 40px rgba(0,0,0,.10)}
.mag-cover{height:190px;background:linear-gradient(135deg,#1a1d3b,#25233a);padding:25px;display:flex;align-items:end}
.mag-cover span{background:#fff;color:#111;border-radius:99px;padding:6px 10px;font-size:11px}
.mag-body{padding:23px}.mag h3{font-weight:500;color:#f3f1eb}.mag p{color:#9fa4ba;font-size:13px;line-height:1.7}

.pill{display:inline-block;background:var(--lav-soft);color:var(--lav);font-size:11px;border-radius:99px;padding:6px 10px}
.smallbtn,.option button,.choice,.pref{background:#11172e;color:#d8dbec;border:1px solid rgba(207,214,255,.12);border-radius:9px;padding:10px 13px}
.smallbtn:hover,.choice:hover,.pref:hover,.option button:hover{border-color:#8f99e7}

.profile{display:grid;grid-template-columns:300px 1fr;gap:20px}
.profile-card{background:linear-gradient(145deg,#121832,#1a2040);color:#fff;border-radius:26px;padding:31px;min-height:330px;border:1px solid rgba(205,211,255,.08)}
.progress{height:7px;background:#ffffff25;border-radius:99px;overflow:hidden;margin:15px 0}
.progress span{display:block;width:42%;height:100%;background:var(--yellow)}
.pref-card{padding:31px}
.pref-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}

.lock{background:#141831;border:1px dashed #7077b9;border-radius:20px;padding:25px;margin-bottom:30px}
.lock h3{margin:0 0 6px;font-weight:500;color:#f3f1eb}.lock p{color:#9ca2b8;font-size:13px}
.lock input{padding:12px;border:1px solid rgba(206,212,255,.12);background:#0d1328;color:#fff;border-radius:99px;width:220px}

.post{padding:25px}.post h3{font-weight:500;font-size:19px;color:#f3f1eb}.meta{color:#999;font-size:11px}
.post p{color:#9fa4ba;font-size:13px;line-height:1.7}.post-actions{display:flex;gap:13px;margin-top:18px}
.post-actions button{border:0;background:none;color:#9fa5bc}.post-actions button:hover{color:#dce0f4}

.footer{background:#070a16;color:#fff;padding:65px 7vw;margin-top:0;border-top:1px solid rgba(206,212,255,.08)}
.footer img{width:100px}.footer p{color:#c7c8d5;font-size:13px}

/* MODAL & TOAST */
.modal{position:fixed;inset:0;background:rgba(3,5,13,.92);backdrop-filter:blur(10px);z-index:900;display:none;align-items:flex-start;justify-content:center;padding:92px 0 0}
.modal.open{display:flex}
body.modal-open{overflow:hidden}
.modal-box{width:min(480px,100%);background:linear-gradient(145deg,#121832,#0e1429);color:#f3f1eb;border-radius:24px;padding:30px;border:1px solid rgba(207,214,255,.12);box-shadow:0 30px 100px rgba(0,0,0,.45);transition:all 0.3s}
.modal-box.large-modal{width:min(880px,94vw);padding:36px 40px}
.modal-box.mileage-fullscreen{
 width:100%;max-width:none;height:calc(100vh - 92px);min-height:0;
 padding:24px 5.5vw 14px;border-radius:0;border:0;
 border-top:1px solid rgba(207,214,255,.08);
 box-shadow:none;
 background:
   radial-gradient(circle at 20% 20%,rgba(83,103,190,.10),transparent 28%),
   linear-gradient(180deg,#080c1c 0%,#050817 100%);
 overflow:hidden;display:flex;flex-direction:column;
}
.footer-brand{margin-bottom:18px}
.mileage-fullscreen .mileage-box{height:100%;min-height:0;display:flex;flex-direction:column}
.mileage-fullscreen .constellation-wrapper{flex:1;min-height:0;margin:12px 0}
.mileage-fullscreen .star-map-scroll{height:100%;min-height:0}
.mileage-fullscreen #constellation-svg{
 height:100%;min-height:500px;width:2080px;min-width:2080px;
}
.mileage-fullscreen .mileage-actions{margin-top:12px}
.mileage-fullscreen .mileage-note{margin-top:7px}
.modal-box input,.modal-box textarea{width:100%;padding:13px;background:#0b1022;color:#f3f1eb;border:1px solid rgba(207,214,255,.12);border-radius:10px;margin:8px 0}
.modal-box input::placeholder,.modal-box textarea::placeholder{color:#6f7590}
.modal-actions{display:flex;gap:10px;margin-top:15px}.close{border:0;background:none;color:#a2a7ba}
.toast{position:fixed;z-index:300;bottom:25px;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;border-radius:12px;padding:13px 18px;display:none;font-size:13px;border:1px solid rgba(207,214,255,0.2)}

/* COMMENTS */
.comment-modal{width:100%}
.comment-modal-head{display:flex;justify-content:space-between;align-items:flex-start}
.comment-modal-head h2{margin:6px 0 0;font-family:"Noto Serif KR",serif;font-weight:500}
.comment-close{border:0;background:rgba(255,255,255,.05);color:#dfe2f1;width:34px;height:34px;border-radius:50%;font-size:23px;line-height:1}
.comment-target{margin:20px 0 16px;padding:15px 16px;border-radius:13px;background:#0b1022;border:1px solid rgba(205,211,255,.08);color:#d8dbea;font-size:14px}
.comment-list{max-height:290px;overflow:auto;padding-right:4px}
.comment-item{padding:14px 0;border-bottom:1px solid rgba(205,211,255,.08)}
.comment-item:last-child{border-bottom:0}
.comment-item>div{display:flex;gap:10px;align-items:center}
.comment-item b{font-size:13px;color:#ecebf2}.comment-item span{font-size:10px;color:#6f7590}
.comment-item p{margin:7px 0 0;color:#a8aec2;font-size:13px;line-height:1.65}
.comment-empty{color:#7e849c;font-size:13px;text-align:center;padding:26px 0}
.comment-write{margin-top:12px;padding-top:16px;border-top:1px solid rgba(205,211,255,.08)}
.comment-write textarea{margin:0 0 10px !important}
.liked{color:#f1b4c7 !important}

/* MILEAGE / STAR MAP */
.mileage-box{text-align:left;color:#f3f1eb}
.mileage-box h2{margin:0 0 7px;font-family:"Noto Serif KR",serif;font-weight:500;font-size:32px;color:#f4df93}
.mileage-box>p{color:#a7aabd;font-size:14px;margin:0 0 18px;line-height:1.7}
.mileage-status{display:flex;align-items:baseline;gap:7px;font-size:15px;font-weight:600;margin-bottom:18px;color:#d8dbec}
.mileage-status span{color:#f4df93;font-size:29px;font-weight:700}
.constellation-wrapper{
  position:relative;background:
    radial-gradient(circle at 22% 30%,rgba(129,150,255,.16),transparent 20%),
    radial-gradient(circle at 74% 72%,rgba(244,223,147,.07),transparent 22%),
    radial-gradient(circle at 48% 50%,rgba(84,103,193,.10),transparent 38%),
    #060a1b;
  border-radius:22px;border:1px solid rgba(207,214,255,.16);
  margin:18px 0;padding:0;overflow:hidden;
  box-shadow:inset 0 0 70px rgba(0,0,0,.58),0 15px 45px rgba(0,0,0,.22);
}
.constellation-wrapper:before{
  content:"";position:absolute;inset:0;pointer-events:none;z-index:1;opacity:.48;
  background-image:
    radial-gradient(circle at 7% 18%,#fff 0 1px,transparent 1.5px),
    radial-gradient(circle at 17% 72%,#fff 0 1px,transparent 1.5px),
    radial-gradient(circle at 29% 36%,#fff 0 .8px,transparent 1.4px),
    radial-gradient(circle at 41% 82%,#fff 0 1px,transparent 1.5px),
    radial-gradient(circle at 53% 19%,#fff 0 1px,transparent 1.5px),
    radial-gradient(circle at 66% 58%,#fff 0 .8px,transparent 1.4px),
    radial-gradient(circle at 79% 24%,#fff 0 1px,transparent 1.5px),
    radial-gradient(circle at 91% 75%,#fff 0 1px,transparent 1.5px);
  background-size:190px 160px,230px 190px,260px 210px,210px 180px,250px 190px,220px 170px,280px 210px,200px 180px;
}
.star-map-scroll{position:relative;z-index:2;overflow-x:auto;overflow-y:hidden;scroll-behavior:smooth;scrollbar-color:#5f6da9 #080c1e;scrollbar-width:thin}
.star-map-scroll::-webkit-scrollbar{height:9px}
.star-map-scroll::-webkit-scrollbar-track{background:#080c1e}
.star-map-scroll::-webkit-scrollbar-thumb{background:#4c598d;border-radius:99px}
#constellation-svg{width:2080px;min-width:2080px;height:510px;display:block}
.constellation-line{stroke:#7888d2;stroke-width:2;fill:none;opacity:.18;filter:drop-shadow(0 0 4px rgba(129,145,236,.35));transition:opacity .5s,stroke .5s}
.constellation-line.active{opacity:.72;stroke:#aab6ff;filter:drop-shadow(0 0 7px #8e9cf1)}
