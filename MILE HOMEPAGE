function loadKitDetail(type) {
  currentKitType = type;
  go('productDetail');
  renderKitDetailView();
}

function renderKitDetailView() {
  const data = kitData[currentKitType];
  const area = document.getElementById('productDetailRenderArea');
  if (!area) return;

  const baseSum = data.baseItems.reduce((sum, i) => sum + (i.price * i.qty), 0);
  const addSum = data.addItems.reduce((sum, i) => sum + (i.price * i.qty), 0);
  const totalPrice = baseSum + addSum;
  const totalItemCount = data.baseItems.reduce((sum, i) => sum + i.qty, 0) + data.addItems.reduce((sum, i) => sum + i.qty, 0);
  const mileageEarned = Math.floor(totalPrice / 1000);

  let html = `
    <div class="detail-custom-container">
      <div class="detail-img-box">
        <div class="detail-img-wrapper">
          <img src="${data.img}" alt="${data.title}">
        </div>
        <div class="detail-img-tag">${data.tag}</div>
      </div>

      <div class="detail-content-box">
        <div class="detail-sub-path">상세 · 개별 품목 구성</div>
        <h2 class="detail-main-title">${data.title}</h2>
        <div class="detail-price-text">총 ₩${totalPrice.toLocaleString()} <span style="font-size:14px;color:#a7aabd;font-weight:400">(${totalItemCount}개 선택됨)</span></div>
        <p class="detail-desc-p">${data.desc}</p>
  `;

  if (currentKitType === 'custom') {
    html += `
      <div class="option-group-title">상황 맞춤 선택</div>
      <div class="situation-btn-group">
        <button class="sit-btn ${currentSit === 'dorm' ? 'active' : ''}" onclick="setSituation('dorm')">고등학교 기숙사</button>
        <button class="sit-btn ${currentSit === 'single' ? 'active' : ''}" onclick="setSituation('single')">1인 가구</button>
      </div>
      <div class="option-group-sub">${currentSit === 'dorm' ? '공동 생활에 맞춘 구성' : '1인 가구 추천 구성'}</div>
    `;
  }

  const sectionTitle = currentKitType === 'custom' ? '기본 구성 · 개별 수량 조절' : '리필 품목 선택 · 수량 조절';
  html += `<div class="option-group-title"><span>${sectionTitle}</span></div>`;
  html += `<div class="item-selection-grid">`;
  data.baseItems.forEach((item, index) => {
    html += `
      <div class="select-item-btn ${item.qty > 0 ? 'selected' : 'unselected'}">
        <div class="item-info-wrap" onclick="toggleItemDirect('base', ${index})">
          <span>${item.name}</span>
          <span class="item-p">₩${item.price.toLocaleString()}</span>
        </div>
        ${item.qty > 0 ? `
          <div class="item-qty-stepper">
            <button onclick="changeItemQty('base', ${index}, -1)">−</button>
            <span>${item.qty}</span>
            <button onclick="changeItemQty('base', ${index}, 1)">+</button>
          </div>
        ` : `
          <button class="item-add-toggle-btn off" onclick="changeItemQty('base', ${index}, 1)">+ 추가</button>
        `}
      </div>
    `;
  });
  html += `</div>`;

  if (data.addItems.length > 0) {
    html += `<div class="option-group-title" style="margin-top:10px"><span>추가 선택 품목</span></div>`;
    html += `<div class="item-selection-grid">`;
    data.addItems.forEach((item, index) => {
      html += `
        <div class="select-item-btn ${item.qty > 0 ? 'selected' : 'unselected'}">
          <div class="item-info-wrap" onclick="toggleItemDirect('add', ${index})">
            <span>${item.name}</span>
            <span class="item-p">+₩${item.price.toLocaleString()}</span>
          </div>
          ${item.qty > 0 ? `
            <div class="item-qty-stepper">
              <button onclick="changeItemQty('add', ${index}, -1)">−</button>
              <span>${item.qty}</span>
              <button onclick="changeItemQty('add', ${index}, 1)">+</button>
            </div>
          ` : `
            <button class="item-add-toggle-btn off" onclick="changeItemQty('add', ${index}, 1)">+ 추가</button>
          `}
        </div>
      `;
    });
    html += `</div>`;
  }

  const isBtnDisabled = totalPrice === 0;
  const btnSubText = isBtnDisabled ? '선택된 상품이 없습니다.' : `구매 완료 시 ${mileageEarned} 마일리지(P)가 자동 적립됩니다.`;

  html += `
        <div class="detail-bottom-bar">
          <div class="cart-submit-btn-wrap">
            <button class="cart-submit-btn" ${isBtnDisabled ? 'disabled' : ''} onclick="addCustomKitToCart(${totalPrice})">
              장바구니 담기 · ₩${totalPrice.toLocaleString()}
            </button>
            <div class="mileage-benefit-info">${btnSubText}</div>
          </div>
        </div>
      </div>
    </div>
  `;

  area.innerHTML = html;
}

function setSituation(sit) {
  currentSit = sit;
  renderKitDetailView();
}

// 개별 상품 수량 변경 (- / +)
function changeItemQty(group, index, delta) {
  const data = kitData[currentKitType];
  const list = group === 'base' ? data.baseItems : data.addItems;
  if (!list[index]) return;
  
  list[index].qty = Math.max(0, list[index].qty + delta);
  renderKitDetailView();
}

// 개별 상품 직접 토글 (클릭 시 켜기/끄기)
function toggleItemDirect(group, index) {
  const data = kitData[currentKitType];
  const list = group === 'base' ? data.baseItems : data.addItems;
  if (!list[index]) return;
  
  if (list[index].qty > 0) {
    list[index].qty = 0;
  } else {
    list[index].qty = 1;
  }
  renderKitDetailView();
}

function addCustomKitToCart(totalPrice) {
  if (totalPrice === 0) return;
  const data = kitData[currentKitType];
  const selectedList = [
    ...data.baseItems.filter(i => i.qty > 0),
    ...data.addItems.filter(i => i.qty > 0)
  ];
  const totalCount = selectedList.reduce((a, b) => a + b.qty, 0);

  cart.push({
    name: `${data.title} (${totalCount}개 품목)`,
    price: totalPrice,
    items: selectedList
  });
  updateBadge();
  toast(`${data.title}이(가) 장바구니에 담겼습니다!`);
}

function updateBadge(){
  document.getElementById('badge').textContent = cart.length;
}

function openCart(){
  const total = cart.reduce((s,p)=>s+p.price,0);
  openCustom(`
    <h2>장바구니</h2>
    ${cart.length ? cart.map(p => `
      <div style="padding:10px 0;border-bottom:1px solid rgba(207,214,255,0.1)">
        <b>${p.name}</b>
        <div style="font-size:12px;color:#a7aabd;margin-top:4px">${p.items ? p.items.map(i=>`${i.name}×${i.qty}`).join(', ') : ''}</div>
        <div style="color:#f4df93;font-weight:600;margin-top:4px">₩${p.price.toLocaleString()}</div>
      </div>
    `).join('') : `<p style="color:var(--muted)">아직 담긴 상품이 없습니다.</p>`}
    <hr style="border-color:rgba(200,200,255,0.1);margin:16px 0">
    <div style="font-size:18px;font-weight:bold;color:#fff;margin-bottom:15px">총 금액: ₩${total.toLocaleString()}</div>
    <p style="font-size:12px;color:#999;margin-bottom:15px">학교 프로젝트 데모 — 실제 결제가 진행되지 않습니다.</p>
    <button class="primary" style="width:100%" ${cart.length===0?'disabled':''} onclick="closeModal();buyDemo()">구매하기</button>
  `);
}

